APP_ENV=development
APP_UID=1000
APP_GID=1000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////data/airports.db
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

PORT_AUTHORITY_GRAPHQL_URL=https://www.jfkairport.com/api/graphql
PORT_AUTHORITY_POLL_MINUTES=5

FLIGHTAWARE_API_KEY=
FLIGHTAWARE_COLLECTION_BUDGET_USD=4.25
FLIGHTAWARE_PLANNER_BUDGET_USD=0.75
FLIGHTAWARE_MONTHLY_HARD_LIMIT_USD=5.00
FLIGHTAWARE_SAMPLE_DAYS_PER_MONTH=10
FLIGHTAWARE_MIN_REQUEST_INTERVAL_SECONDS=6.5
FLIGHTAWARE_RATE_LIMIT_COOLDOWN_SECONDS=61
FLIGHTAWARE_RAW_RETENTION_DAYS=29
PORT_AUTHORITY_RAW_RETENTION_DAYS=90

MODEL_ARTIFACT_DIR=/artifacts
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

DOMAIN=airplanner.openjack.xyz
